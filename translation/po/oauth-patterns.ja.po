msgstr ""
"import {Heading} from \"@/components/Heading\"\n"
"\n"
"export const header = {\n"
"  title: 'OAuthパターン集',\n"
"  description: 'atprotoアプリケーションにおけるOAuthの発展的な実装パターン',\n"
