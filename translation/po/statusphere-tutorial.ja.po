#. type: Plain text
#: src/guides/statusphere-tutorial/en.mdx:316
#, no-wrap
msgid "[Tap](/guides/backfilling#using-tap) is the best way to synchronize and stream AT Protocol records. You'll use the Tap [TypeScript library](https://www.npmjs.com/package/@atproto/tap) to sync new records in your database. Create `lib/tap/index.ts`:\n"
msgstr "[Tap](/guides/backfilling#using-tap)はATプロトコルレコードを同期・ストリームする最適な方法です。Tapの[TypeScriptライブラリ](https://www.npmjs.com/package/@atproto/tap)を使って、データベースへ新規レコードを同期します。`lib/tap/index.ts`を作成してください:\n"

#. type: Plain text
#: src/guides/statusphere-tutorial/en.mdx:319
#, no-wrap
msgid ""
"```typescript\n"
"import { Tap } from \"@atproto/tap\";\n"
msgstr ""
"```typescript\n"
"import { Tap } from \"@atproto/tap\";\n"

#. type: Plain text
#: src/guides/statusphere-tutorial/en.mdx:321
#, no-wrap
msgid "const TAP_URL = process.env.TAP_URL || \"http://localhost:2480\";\n"
msgstr "const TAP_URL = process.env.TAP_URL || \"http://localhost:2480\";\n"

#. type: Plain text
#: src/guides/statusphere-tutorial/en.mdx:323
#, no-wrap
msgid "let _tap: Tap | null = null;\n"
msgstr "let _tap: Tap | null = null;\n"

#. type: Plain text
#: src/guides/statusphere-tutorial/en.mdx:331
#, no-wrap
msgid ""
"export const getTap = (): Tap => {\n"
"  if (!_tap) {\n"
"    _tap = new Tap(TAP_URL);\n"
"  }\n"
"  return _tap;\n"
"};\n"
"```\n"
msgstr ""
"export const getTap = (): Tap => {\n"
"  if (!_tap) {\n"
"    _tap = new Tap(TAP_URL);\n"
"  }\n"
"  return _tap;\n"
"};\n"
"```\n"

#. type: Plain text
#: src/guides/statusphere-tutorial/en.mdx:333
#, no-wrap
msgid "Next, create `lib/db/queries.ts` with some database queries for handling Tap events:\n"
msgstr "次に、Tapイベント処理用のデータベースクエリを`lib/db/queries.ts`に作成します。\n"

#. type: Plain text
#: src/guides/statusphere-tutorial/en.mdx:338
#, no-wrap
msgid ""
"```typescript\n"
"import { getDb, AccountTable, StatusTable, DatabaseSchema } from \".\";\n"
"import { AtUri } from \"@atproto/syntax\";\n"
"import { Transaction } from \"kysely\";\n"
msgstr ""
"```typescript\n"
"import { getDb, AccountTable, StatusTable, DatabaseSchema } from \".\";\n"
"import { AtUri } from \"@atproto/syntax\";\n"
"import { Transaction } from \"kysely\";\n"

#. type: Plain text
#: src/guides/statusphere-tutorial/en.mdx:350
#, no-wrap
msgid ""
"export async function getAccountStatus(did: string) {\n"
"  const db = getDb();\n"
"  const status = await db\n"
"    .selectFrom(\"status\")\n"
"    .selectAll()\n"
"    .where(\"authorDid\", \"=\", did)\n"
"    .orderBy(\"createdAt\", \"desc\")\n"
"    .limit(1)\n"
"    .executeTakeFirst();\n"
"  return status ?? null;\n"
"}\n"
msgstr ""
"export async function getAccountStatus(did: string) {\n"
"  const db = getDb();\n"
"  const status = await db\n"
"    .selectFrom(\"status\")\n"
"    .selectAll()\n"
"    .where(\"authorDid\", \"=\", did)\n"
"    .orderBy(\"createdAt\", \"desc\")\n"
"    .limit(1)\n"
"    .executeTakeFirst();\n"
"  return status ?? null;\n"
"}\n"

#. type: Plain text
#: src/guides/statusphere-tutorial/en.mdx:369
#, no-wrap
msgid ""
"export async function insertStatus(data: StatusTable) {\n"
"  getDb()\n"
"    .transaction()\n"
"    .execute(async (tx) => {\n"
"      await tx\n"
"        .insertInto(\"status\")\n"
"        .values(data)\n"
"        .onConflict((oc) =>\n"
"          oc.column(\"uri\").doUpdateSet({\n"
"            status: data.status,\n"
"            createdAt: data.createdAt,\n"
"            indexedAt: data.indexedAt,\n"
"          }),\n"
"        )\n"
"        .execute();\n"
"      setCurrStatus(tx, data.authorDid);\n"
"    });\n"
"}\n"
msgstr ""
"export async function insertStatus(data: StatusTable) {\n"
"  getDb()\n"
"    .transaction()\n"
"    .execute(async (tx) => {\n"
"      await tx\n"
"        .insertInto(\"status\")\n"
"        .values(data)\n"
"        .onConflict((oc) =>\n"
"          oc.column(\"uri\").doUpdateSet({\n"
"            status: data.status,\n"
"            createdAt: data.createdAt,\n"
"            indexedAt: data.indexedAt,\n"
"          }),\n"
"        )\n"
"        .execute();\n"
"      setCurrStatus(tx, data.authorDid);\n"
"    });\n"
"}\n"

#. type: Plain text
#: src/guides/statusphere-tutorial/en.mdx:378
#, no-wrap
msgid ""
"export async function deleteStatus(uri: AtUri) {\n"
"  await getDb()\n"
"    .transaction()\n"
"    .execute(async (tx) => {\n"
"      await tx.deleteFrom(\"status\").where(\"uri\", \"=\", uri.toString()).execute();\n"
"      await setCurrStatus(tx, uri.hostname);\n"
"    });\n"
"}\n"
msgstr ""
"export async function deleteStatus(uri: AtUri) {\n"
"  await getDb()\n"
"    .transaction()\n"
"    .execute(async (tx) => {\n"
"      await tx.deleteFrom(\"status\").where(\"uri\", \"=\", uri.toString()).execute();\n"
"      await setCurrStatus(tx, uri.hostname);\n"
"    });\n"
"}\n"

#. type: Plain text
#: src/guides/statusphere-tutorial/en.mdx:391
#, no-wrap
msgid ""
"export async function upsertAccount(data: AccountTable) {\n"
"  await getDb()\n"
"    .insertInto(\"account\")\n"
"    .values(data)\n"
"    .onConflict((oc) =>\n"
"      oc.column(\"did\").doUpdateSet({\n"
"        handle: data.handle,\n"
"        active: data.active,\n"
"      }),\n"
"    )\n"
"    .execute();\n"
"}\n"
msgstr ""
"export async function upsertAccount(data: AccountTable) {\n"
"  await getDb()\n"
"    .insertInto(\"account\")\n"
"    .values(data)\n"
"    .onConflict((oc) =>\n"
"      oc.column(\"did\").doUpdateSet({\n"
"        handle: data.handle,\n"
"        active: data.active,\n"
"      }),\n"
"    )\n"
"    .execute();\n"
"}\n"

#. type: Plain text
#: src/guides/statusphere-tutorial/en.mdx:396
#, no-wrap
msgid ""
"export async function deleteAccount(did: string) {\n"
"  await getDb().deleteFrom(\"account\").where(\"did\", \"=\", did).execute();\n"
"  await getDb().deleteFrom(\"status\").where(\"authorDid\", \"=\", did).execute();\n"
"}\n"
msgstr ""
"export async function deleteAccount(did: string) {\n"
"  await getDb().deleteFrom(\"account\").where(\"did\", \"=\", did).execute();\n"
"  await getDb().deleteFrom(\"status\").where(\"authorDid\", \"=\", did).execute();\n"
"}\n"

#. type: Plain text
#: src/guides/statusphere-tutorial/en.mdx:421
#, no-wrap
msgid ""
"// Helper to update which status is \"current\" for a user (inside a transaction)\n"
"async function setCurrStatus(tx: Transaction<DatabaseSchema>, did: string) {\n"
"  // Clear current flag for all user's statuses\n"
"  await tx\n"
"    .updateTable(\"status\")\n"
"    .set({ current: 0 })\n"
"    .where(\"authorDid\", \"=\", did)\n"
"    .where(\"current\", \"=\", 1)\n"
"    .execute();\n"
"  // Set the most recent status as current\n"
"  await tx\n"
"    .updateTable(\"status\")\n"
"    .set({ current: 1 })\n"
"    .where(\"uri\", \"=\", (qb) =>\n"
"      qb\n"
"        .selectFrom(\"status\")\n"
"        .select(\"uri\")\n"
"        .where(\"authorDid\", \"=\", did)\n"
"        .orderBy(\"createdAt\", \"desc\")\n"
"        .limit(1),\n"
"    )\n"
"    .execute();\n"
"}\n"
"```\n"
msgstr ""
"// ユーザーのステータスを最新に更新するヘルパー（トランザクション内)\n"
"async function setCurrStatus(tx: Transaction<DatabaseSchema>, did: string) {\n"
"  // 全ユーザーのステータスの最新フラグをクリア\n"
"  await tx\n"
"    .updateTable(\"status\")\n"
"    .set({ current: 0 })\n"
"    .where(\"authorDid\", \"=\", did)\n"
"    .where(\"current\", \"=\", 1)\n"
"    .execute();\n"
"  // 直近のステータスを最新に設定\n"
"  await tx\n"
"    .updateTable(\"status\")\n"
"    .set({ current: 1 })\n"
"    .where(\"uri\", \"=\", (qb) =>\n"
"      qb\n"
"        .selectFrom(\"status\")\n"
"        .select(\"uri\")\n"
"        .where(\"authorDid\", \"=\", did)\n"
"        .orderBy(\"createdAt\", \"desc\")\n"
"        .limit(1),\n"
"    )\n"
"    .execute();\n"
"}\n"
"```\n"

#. type: Plain text
#: src/guides/statusphere-tutorial/en.mdx:423
#, no-wrap
msgid "The `setCurrStatus` helper ensures only the most recent status per user has `current = 1`. This will be used later on.\n"
msgstr "`setCurrStatus`ヘルパーは、各ユーザーで最新ステータスだけが`current = 1`になるよう保証します。この後の処理で利用します。\n"

#. type: Plain text
#: src/guides/statusphere-tutorial/en.mdx:425
#, no-wrap
msgid "Tap will deliver events through a webhook endpoint at `app/api/webhook/route.ts`:\n"
msgstr "Tapは`app/api/webhook/route.ts`のwebhookエンドポイント経由でイベントを配信します。\n"

#. type: Plain text
#: src/guides/statusphere-tutorial/en.mdx:437
#, no-wrap
msgid ""
"```typescript\n"
"import { NextRequest, NextResponse } from \"next/server\";\n"
"import { parseTapEvent, assureAdminAuth } from \"@atproto/tap\";\n"
"import { AtUri } from \"@atproto/syntax\";\n"
"import {\n"
"  upsertAccount,\n"
"  insertStatus,\n"
"  deleteStatus,\n"
"  deleteAccount,\n"
"} from \"@/lib/db/queries\";\n"
