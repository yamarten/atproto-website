"                  <span className=\"text-zinc-400 dark:text-zinc-500 text-xs ml-auto\">\n"
"                    {timeAgo(s.createdAt)}\n"
"                  </span>\n"
"                </li>\n"
"              ))}\n"
"            </ul>\n"
"          )}\n"
"        </div>\n"
"      </main>\n"
"    </div>\n"
"  );\n"
"}\n"
msgstr ""
"        <div className=\"bg-white dark:bg-zinc-900 rounded-lg border border-zinc-200 dark:border-zinc-800 p-6\">\n"
"          <h3 className=\"text-sm font-medium text-zinc-500 dark:text-zinc-400 mb-3\">\n"
"            Recent\n"
"          </h3>\n"
"          {statuses.length === 0 ? (\n"
"            <p className=\"text-zinc-500 dark:text-zinc-400 text-sm\">\n"
"              No statuses yet. Be the first!\n"
"            </p>\n"
"          ) : (\n"
"            <ul className=\"space-y-3\">\n"
"              {statuses.map((s) => (\n"
"                <li key={s.uri} className=\"flex items-center gap-3\">\n"
"                  <span className=\"text-2xl\">{s.status}</span>\n"
"                  <span className=\"text-zinc-600 dark:text-zinc-400 text-sm\">\n"
"                    @{s.handle}\n"
"                  </span>\n"
"                  <span className=\"text-zinc-400 dark:text-zinc-500 text-xs ml-auto\">\n"
"                    {timeAgo(s.createdAt)}\n"
"                  </span>\n"
"                </li>\n"
"              ))}\n"
"            </ul>\n"
"          )}\n"
"        </div>\n"
"      </main>\n"
"    </div>\n"
"  );\n"
"}\n"

#. type: Plain text
#: src/guides/statusphere-tutorial/en.mdx:707
#, no-wrap
msgid ""
"function timeAgo(dateString: string): string {\n"
"  const now = Date.now();\n"
"  const then = new Date(dateString).getTime();\n"
"  const seconds = Math.floor((now - then) / 1000);\n"
"  if (seconds < 60) return \"just now\";\n"
"  const minutes = Math.floor(seconds / 60);\n"
"  if (minutes < 60) return `${minutes}m`;\n"
"  const hours = Math.floor(minutes / 60);\n"
"  if (hours < 24) return `${hours}h`;\n"
"  const days = Math.floor(hours / 24);\n"
"  return `${days}d`;\n"
"}\n"
"```\n"
msgstr ""
"function timeAgo(dateString: string): string {\n"
"  const now = Date.now();\n"
"  const then = new Date(dateString).getTime();\n"
"  const seconds = Math.floor((now - then) / 1000);\n"
"  if (seconds < 60) return \"just now\";\n"
"  const minutes = Math.floor(seconds / 60);\n"
"  if (minutes < 60) return `${minutes}m`;\n"
"  const hours = Math.floor(minutes / 60);\n"
"  if (hours < 24) return `${hours}h`;\n"
"  const days = Math.floor(hours / 24);\n"
"  return `${days}d`;\n"
"}\n"
"```\n"

#. type: Plain text
#: src/guides/statusphere-tutorial/en.mdx:709
#, no-wrap
msgid "Now logged-in users will see \"Signed in as @theirhandle\" instead of just \"Signed in\", along with a feed of recent statuses from all users, and a \"Top Statuses\" section showing the most popular current statuses.\n"
msgstr "これでログイン中ユーザーには単なる\"Signed in\"ではなく\"Signed in as @theirhandle\"が表示され、全ユーザーの最新ステータスフィードと、人気の現在ステータスを示す\"Top Statuses\"セクションも表示されます。\n"

#. type: Plain text
#: src/guides/statusphere-tutorial/en.mdx:711
#, no-wrap
msgid "You can stop and restart your app with `pnpm dev` again.\n"
msgstr "`pnpm dev`でアプリを停止・再起動できます。\n"

#. type: Plain text
#: src/guides/statusphere-tutorial/en.mdx:713
#, no-wrap
msgid "One last thing — remember, you only added a single data source to `tap` earlier. To see statuses from across the entire network, stop and re-run `tap` with the `--signal-collection` flag:\n"
msgstr "最後に、先ほど`tap`には単一データソースしか追加していません。ネットワーク全体のステータスを見るには、`--signal-collection`フラグ付きで`tap`を停止して再実行します。\n"

#. type: Plain text
#: src/guides/statusphere-tutorial/en.mdx:720
#, no-wrap
msgid ""
"```bash\n"
"tap run \\\n"
"  --webhook-url=http://localhost:3000/api/webhook \\\n"
"  --collection-filters=xyz.statusphere.status \\\n"
"  --signal-collection=xyz.statusphere.status\n"
"```\n"
msgstr ""
"```bash\n"
"tap run \\\n"
"  --webhook-url=http://localhost:3000/api/webhook \\\n"
"  --collection-filters=xyz.statusphere.status \\\n"
"  --signal-collection=xyz.statusphere.status\n"
"```\n"

#. type: Plain text
#: src/guides/statusphere-tutorial/en.mdx:722
#, no-wrap
msgid "... and you'll start seeing statuses from other users on the network!\n"
msgstr "すると、ネットワーク上の他ユーザーのステータスも見えるようになります。\n"

#. type: Plain text
#: src/guides/statusphere-tutorial/en.mdx:726
#, no-wrap
msgid ""
"<Container>\n"
"  <Image src={feed} alt=\"\" className=\"w-full max-w-md mx-auto\" />\n"
"</Container>\n"
msgstr ""
"<Container>\n"
"  <Image src={feed} alt=\"\" className=\"w-full max-w-md mx-auto\" />\n"
"</Container>\n"

#. type: Plain text
#: src/guides/statusphere-tutorial/en.mdx:730
#, no-wrap
msgid "You've now built a complete Atproto app that uses OAuth to sign in, a custom Lexicon to define status records, and Tap to synchronize records in real-time.\n"
msgstr "これで、OAuthログイン、カスタムLexiconによるステータスレコード定義、Tapによるリアルタイム同期を備えた完全なAtprotoアプリが完成しました。\n"

