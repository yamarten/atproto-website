"  did: string;\n"
"  handle: string;\n"
"  active: 0 | 1;\n"
"}\n"

#. type: Plain text
#: src/guides/statusphere-tutorial/en.mdx:100
#, no-wrap
msgid ""
"export interface StatusTable {\n"
"  uri: string;\n"
"  authorDid: string;\n"
"  status: string;\n"
"  createdAt: string;\n"
"  indexedAt: string;\n"
"  current: 0 | 1;\n"
"}\n"
"```\n"
msgstr ""
"export interface StatusTable {\n"
"  uri: string;\n"
"  authorDid: string;\n"
"  status: string;\n"
"  createdAt: string;\n"
"  indexedAt: string;\n"
"  current: 0 | 1;\n"
"}\n"
"```\n"

#. type: Plain text
#: src/guides/statusphere-tutorial/en.mdx:102
#, no-wrap
msgid "Next, add the migrations script that creates these tables. If you're building on top of the OAuth tutorial and have already deployed/migrated your database, you'll want to put these in a new migration, e.g. called \"002\", in `lib/db/migrations.ts`:\n"
msgstr "次に、これらのテーブルを作成する移行スクリプトを追加します。OAuthチュートリアルを土台にしていて、すでにデータベースをデプロイ/移行済みの場合は、`lib/db/migrations.ts`に新しいmigration（\"002\"など）として追加してください。\n"

#. type: Plain text
#: src/guides/statusphere-tutorial/en.mdx:114
#, no-wrap
msgid ""
"```typescript\n"
"const migrations: Record<string, Migration> = {\n"
"  \"001\": {} // existing migrations for auth tables\n"
"  \"002\": {\n"
"    async up(db: Kysely<unknown>) {\n"
"      await db.schema\n"
"        .createTable(\"account\")\n"
"        .addColumn(\"did\", \"text\", (col) => col.primaryKey())\n"
"        .addColumn(\"handle\", \"text\", (col) => col.notNull())\n"
"        .addColumn(\"active\", \"integer\", (col) => col.notNull().defaultTo(1))\n"
"        .execute();\n"
msgstr ""
"```typescript\n"
"const migrations: Record<string, Migration> = {\n"
"  \"001\": {} // 認可テーブル用の既存migration\n"
"  \"002\": {\n"
"    async up(db: Kysely<unknown>) {\n"
"      await db.schema\n"
"        .createTable(\"account\")\n"
"        .addColumn(\"did\", \"text\", (col) => col.primaryKey())\n"
"        .addColumn(\"handle\", \"text\", (col) => col.notNull())\n"
"        .addColumn(\"active\", \"integer\", (col) => col.notNull().defaultTo(1))\n"
"        .execute();\n"

#. type: Plain text
#: src/guides/statusphere-tutorial/en.mdx:124
#, no-wrap
msgid ""
"      await db.schema\n"
"        .createTable(\"status\")\n"
"        .addColumn(\"uri\", \"text\", (col) => col.primaryKey())\n"
"        .addColumn(\"authorDid\", \"text\", (col) => col.notNull())\n"
"        .addColumn(\"status\", \"text\", (col) => col.notNull())\n"
"        .addColumn(\"createdAt\", \"text\", (col) => col.notNull())\n"
"        .addColumn(\"indexedAt\", \"text\", (col) => col.notNull())\n"
"        .addColumn(\"current\", \"integer\", (col) => col.notNull().defaultTo(0))\n"
"        .execute();\n"
msgstr ""
"      await db.schema\n"
"        .createTable(\"status\")\n"
"        .addColumn(\"uri\", \"text\", (col) => col.primaryKey())\n"
"        .addColumn(\"authorDid\", \"text\", (col) => col.notNull())\n"
"        .addColumn(\"status\", \"text\", (col) => col.notNull())\n"
"        .addColumn(\"createdAt\", \"text\", (col) => col.notNull())\n"
"        .addColumn(\"indexedAt\", \"text\", (col) => col.notNull())\n"
"        .addColumn(\"current\", \"integer\", (col) => col.notNull().defaultTo(0))\n"
"        .execute();\n"

#. type: Plain text
#: src/guides/statusphere-tutorial/en.mdx:140
#, no-wrap
msgid ""
"      await db.schema\n"
"        .createIndex(\"status_current_idx\")\n"
"        .on(\"status\")\n"
"        .columns([\"current\", \"indexedAt\"])\n"
"        .execute();\n"
"    },\n"
"    async down(db: Kysely<unknown>) {\n"
"      await db.schema.dropTable(\"status\").execute();\n"
"      await db.schema.dropTable(\"account\").execute();\n"
"      await db.schema.dropTable(\"auth_session\").execute();\n"
"      await db.schema.dropTable(\"auth_state\").execute();\n"
"    },\n"
"  },\n"
"};\n"
"```\n"
msgstr ""
"      await db.schema\n"
"        .createIndex(\"status_current_idx\")\n"
"        .on(\"status\")\n"
"        .columns([\"current\", \"indexedAt\"])\n"
"        .execute();\n"
"    },\n"
"    async down(db: Kysely<unknown>) {\n"
"      await db.schema.dropTable(\"status\").execute();\n"
"      await db.schema.dropTable(\"account\").execute();\n"
"      await db.schema.dropTable(\"auth_session\").execute();\n"
"      await db.schema.dropTable(\"auth_state\").execute();\n"
"    },\n"
"  },\n"
"};\n"
"```\n"

