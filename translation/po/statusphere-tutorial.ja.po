#. type: Plain text
#: src/guides/statusphere-tutorial/en.mdx:144
#, no-wrap
msgid "## Part 3: Status Submission\n"
msgstr "<Heading level={2} id=\"part-3-status-submission\">パート3：ステータス投稿</Heading>\n"

#. type: Plain text
#: src/guides/statusphere-tutorial/en.mdx:146
#, no-wrap
msgid "First you'll build the feature that allows users to write their status to their [PDS](/guides/the-at-stack#pds). Create a new API route at `app/api/status/route.ts`:\n"
msgstr "まず、ユーザーが自分の[PDS](/guides/the-at-stack#pds)にステータスを書き込める機能を作成します。`app/api/status/route.ts`に新しいAPIルートを作成してください。\n"

#. type: Plain text
#: src/guides/statusphere-tutorial/en.mdx:153
#, no-wrap
msgid ""
"```typescript\n"
"import { NextRequest, NextResponse } from \"next/server\";\n"
"import { Client } from \"@atproto/lex\";\n"
"import { getSession } from \"@/lib/auth/session\";\n"
"import { getOAuthClient } from \"@/lib/auth/client\";\n"
"import * as xyz from \"@/src/lexicons/xyz\";\n"
msgstr ""
"```typescript\n"
"import { NextRequest, NextResponse } from \"next/server\";\n"
"import { Client } from \"@atproto/lex\";\n"
"import { getSession } from \"@/lib/auth/session\";\n"
"import { getOAuthClient } from \"@/lib/auth/client\";\n"
"import * as xyz from \"@/src/lexicons/xyz\";\n"

#. type: Plain text
#: src/guides/statusphere-tutorial/en.mdx:159
#, no-wrap
msgid ""
"export async function POST(request: NextRequest) {\n"
"  const session = await getSession();\n"
"  if (!session) {\n"
"    return NextResponse.json({ error: \"Unauthorized\" }, { status: 401 });\n"
"  }\n"
msgstr ""
"export async function POST(request: NextRequest) {\n"
"  const session = await getSession();\n"
"  if (!session) {\n"
"    return NextResponse.json({ error: \"Unauthorized\" }, { status: 401 });\n"
"  }\n"

#. type: Plain text
#: src/guides/statusphere-tutorial/en.mdx:161
#, no-wrap
msgid "  const { status } = await request.json();\n"
msgstr "  const { status } = await request.json();\n"

#. type: Plain text
#: src/guides/statusphere-tutorial/en.mdx:165
#, no-wrap
msgid ""
"  if (!status || typeof status !== \"string\") {\n"
"    return NextResponse.json({ error: \"Status is required\" }, { status: 400 });\n"
"  }\n"
msgstr ""
"  if (!status || typeof status !== \"string\") {\n"
"    return NextResponse.json({ error: \"Status is required\" }, { status: 400 });\n"
"  }\n"

#. type: Plain text
#: src/guides/statusphere-tutorial/en.mdx:169
#, no-wrap
msgid ""
"  const client = await getOAuthClient();\n"
"  const oauthSession = await client.restore(session.did);\n"
"  const lexClient = new Client(oauthSession);\n"
msgstr ""
"  const client = await getOAuthClient();\n"
"  const oauthSession = await client.restore(session.did);\n"
"  const lexClient = new Client(oauthSession);\n"

#. type: Plain text
#: src/guides/statusphere-tutorial/en.mdx:175
#, no-wrap
msgid ""
"  const createdAt = new Date().toISOString();\n"
"  const res = await lexClient.create(xyz.statusphere.status, {\n"
"    status,\n"
"    createdAt,\n"
"  });\n"
msgstr ""
"  const createdAt = new Date().toISOString();\n"
"  const res = await lexClient.create(xyz.statusphere.status, {\n"
"    status,\n"
"    createdAt,\n"
"  });\n"

#. type: Plain text
#: src/guides/statusphere-tutorial/en.mdx:182
#, no-wrap
msgid ""
"  return NextResponse.json({\n"
"    success: true,\n"
"    uri: res.uri,\n"
"  });\n"
"}\n"
"```\n"
msgstr ""
"  return NextResponse.json({\n"
"    success: true,\n"
"    uri: res.uri,\n"
"  });\n"
"}\n"
"```\n"

#. type: Plain text
#: src/guides/statusphere-tutorial/en.mdx:184
#, no-wrap
msgid "This verifies that a user is logged in, creates a lex `Client` with their OAuth session, and then creates a new `xyz.statusphere.status` record with the submitted status text.\n"
