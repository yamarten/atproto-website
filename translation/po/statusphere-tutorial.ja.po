#. type: Plain text
#: src/guides/statusphere-tutorial/en.mdx:90
#, no-wrap
msgid ""
"export interface AccountTable {\n"
"  did: string;\n"
"  handle: string;\n"
"  active: 0 | 1;\n"
"}\n"
msgstr ""
