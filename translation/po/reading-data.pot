#: src/guides/reading-data/en.mdx:66
#, no-wrap
msgid "## DID Resolution\n"
msgstr ""

#. type: Plain text
#: src/guides/reading-data/en.mdx:68
#, no-wrap
msgid "In atproto, user data is resolved through [DIDs](/guides/sync#data-repositories), also known as [Decentralized Identifiers](https://en.wikipedia.org/wiki/Decentralized_identifier). Most AT Protocol applications use [`did:plc` DIDs](/guides/the-at-stack#did-plc) when registering user accounts.\n"
msgstr ""

#. type: Plain text
#: src/guides/reading-data/en.mdx:70
#, no-wrap
msgid "You can resolve a known username to a DID using the `com.atproto.identity.resolveHandle` endpoint. This means that you can just visit this address in a browser with a `handle=` arugment to look up your DID:\n"
msgstr ""

#. type: Plain text
#: src/guides/reading-data/en.mdx:72
#, no-wrap
msgid "<ResolveHandleUrl />\n"
msgstr ""

#. type: Plain text
#: src/guides/reading-data/en.mdx:74
#, no-wrap
msgid "<ResolveHandleResponse />\n"
msgstr ""

#. type: Plain text
#: src/guides/reading-data/en.mdx:76
#, no-wrap
msgid "The TypeScript SDK also provides the DID of the currently-authenticated as `client.did`:\n"
msgstr ""

#. type: Plain text
#: src/guides/reading-data/en.mdx:78
#, no-wrap
msgid "<ClientDidTs />\n"
msgstr ""

