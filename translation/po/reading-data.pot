"    </TabPanel>\n"
"    <TabPanel value=\"go\">\n"
"    You can read posts from a user's data repository with `RepoListRecords()`:\n"
msgstr ""

#. type: Plain text
#: src/guides/reading-data/en.mdx:40
#, no-wrap
msgid ""
"    <ListRecordsGo />\n"
"    </TabPanel>\n"
"  </TabPanels>\n"
"</TabGroup>\n"
msgstr ""

