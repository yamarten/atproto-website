msgid "## Listing Records\n"
msgstr ""

#. type: Plain text
#: src/guides/reading-data/en.mdx:28
#, no-wrap
msgid ""
"<TabGroup defaultValue=\"ts\">\n"
"  <TabList>\n"
"    <Tab value=\"ts\">TypeScript</Tab>\n"
"    <Tab value=\"go\">Go</Tab>\n"
"  </TabList>\n"
"  <TabPanels>\n"
"    <TabPanel value=\"ts\">\n"
"    You can read records from a user's data repository with `client.list()`:\n"
