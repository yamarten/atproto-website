"    </form>\n"
"  );\n"
"}\n"
"```\n"

#. type: Plain text
#: src/guides/oauth-tutorial/en.mdx:359
#, no-wrap
msgid "Do the same for `components/LogoutButton.tsx`:\n"
msgstr "同様に`components/LogoutButton.tsx`も作成します。\n"

#. type: Plain text
#: src/guides/oauth-tutorial/en.mdx:364
#, no-wrap
msgid "import { useRouter } from \"next/navigation\";\n"
msgstr "import { useRouter } from \"next/navigation\";\n"

#. type: Plain text
#: src/guides/oauth-tutorial/en.mdx:367
#, no-wrap
msgid ""
"export function LogoutButton() {\n"
"  const router = useRouter();\n"
msgstr ""
"export function LogoutButton() {\n"
"  const router = useRouter();\n"

#. type: Plain text
#: src/guides/oauth-tutorial/en.mdx:372
#, no-wrap
msgid ""
"  async function handleLogout() {\n"
"    await fetch(\"/oauth/logout\", { method: \"POST\" });\n"
"    router.refresh();\n"
"  }\n"
msgstr ""
"  async function handleLogout() {\n"
"    await fetch(\"/oauth/logout\", { method: \"POST\" });\n"
