"    >\n"
"      Sign out\n"
"    </button>\n"
"  );\n"
"}\n"
"```\n"
msgstr ""
"  return (\n"
"    <button\n"
"      onClick={handleLogout}\n"
"      className=\"text-sm text-zinc-500 hover:text-zinc-700 dark:text-zinc-400 dark:hover:text-zinc-200\"\n"
"    >\n"
"      Sign out\n"
"    </button>\n"
"  );\n"
"}\n"
"```\n"

#. type: Plain text
#: src/guides/oauth-tutorial/en.mdx:385
