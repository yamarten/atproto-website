"              <div className=\"flex items-center justify-between\">\n"
"                <p className=\"text-sm text-zinc-600 dark:text-zinc-400\">\n"
"                  Signed in as{\" \"}\n"
"                  <span className=\"font-mono\">{session.did}</span>\n"
"                </p>\n"
"                <LogoutButton />\n"
"              </div>\n"
"              <p className=\"text-green-600\">Authentication working!</p>\n"
"            </div>\n"
