#: src/guides/sync/en.mdx:29
#, no-wrap
msgid "Take, for example, a single AT record:\n"
msgstr ""

#. type: Plain text
#: src/guides/sync/en.mdx:31
#, no-wrap
msgid "<AtUriExample />\n"
msgstr ""

#. type: Plain text
#: src/guides/sync/en.mdx:33
#, no-wrap
msgid "This can be broken down as `at://DID/NSID/rkey` , or `at://repository/collection/record`. It has a corresponding CID of `bafyreidgbehqwweghrrddfu6jgj7lyr6fwhzgazhirnszdb5lvr7iynkiy`.\n"
msgstr ""

#. type: Plain text
#: src/guides/sync/en.mdx:35
#, no-wrap
msgid "When making a write request to an AT API endpoint — such as when creating a new post — this full repository path will be returned as a response:\n"
msgstr ""

#. type: Plain text
#: src/guides/sync/en.mdx:37
#, no-wrap
