msgstr ""

#. type: Plain text
#: src/guides/installing-lexicons/en.mdx:22
#, no-wrap
msgid "This provides the `lex` command, which you can use to install Lexicons into a local project:\n"
msgstr ""

#. type: Plain text
#: src/guides/installing-lexicons/en.mdx:24
#, no-wrap
msgid "<LexInstallLexicons />\n"
msgstr ""

#. type: Plain text
#: src/guides/installing-lexicons/en.mdx:26
#, no-wrap
msgid "This creates:\n"
