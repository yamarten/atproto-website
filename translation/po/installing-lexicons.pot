msgstr ""

#. type: Plain text
#: src/guides/installing-lexicons/en.mdx:18
#, no-wrap
msgid "First, install the `@atproto/lex` package:\n"
msgstr ""

#. type: Plain text
#: src/guides/installing-lexicons/en.mdx:20
