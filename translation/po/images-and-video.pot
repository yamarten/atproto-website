#, no-wrap
msgid "## Using blobs\n"
msgstr ""

#. type: Plain text
#: src/guides/images-and-video/en.mdx:17
#, no-wrap
msgid "\"Blobs\" are media files stored alongside an account's repository. They include images, video, and audio, but could also include any other file format. Blobs are referenced by individual records by the **`blob`** lexicon datatype, which includes a content hash (CID; `ref`) for the blob .\n"
msgstr ""

