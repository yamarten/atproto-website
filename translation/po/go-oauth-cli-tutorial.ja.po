#. type: Plain text
#: src/guides/go-oauth-cli-tutorial/en.mdx:5
#, no-wrap
msgid ""
"export const header = {\n"
"  title: 'OAuth with Go Tutorial',\n"
"  description: 'Authenticate with atproto OAuth from a Go app',\n"
"}\n"
msgstr ""
"export const header = {\n"
"  title: 'OAuth with Goチュートリアル',\n"
"  description: 'Goアプリからatproto OAuthで認証する',\n"
"}\n"

#. type: Plain text
#: src/guides/go-oauth-cli-tutorial/en.mdx:7
#, no-wrap
msgid "In this tutorial, you'll build a minimal Go tool that authenticates a user with [atproto OAuth](/guides/auth) and fetches their session info. The entire app fits in a single file.\n"
msgstr "このチュートリアルでは、[atproto OAuth](/guides/auth)でユーザー認証し、セッション情報を取得する最小構成のGoツールを作成します。アプリ全体は1つのファイルに収まります。\n"

#. type: Plain text
#: src/guides/go-oauth-cli-tutorial/en.mdx:9
#, no-wrap
msgid "This is a good starting point for understanding how OAuth works in AT Protocol. For a TypeScript version, see the [OAuth with Node Tutorial](/guides/oauth-cli-tutorial). For building production web apps, see the [OAuth with NextJS Tutorial](/guides/oauth-tutorial).\n"
msgstr "これはATプロトコルでOAuthがどう動くかを理解するための良い出発点です。TypeScript版は[OAuth with Nodeチュートリアル](/guides/oauth-cli-tutorial)、本番向けウェブアプリ構築は[OAuth with NextJSチュートリアル](/guides/oauth-tutorial)を参照してください。\n"

#. type: Plain text
#: src/guides/go-oauth-cli-tutorial/en.mdx:13
#, no-wrap
msgid "You should have a working understanding of Go.\n"
msgstr "Goの基本的な理解を前提としています。\n"

#. type: Plain text
#: src/guides/go-oauth-cli-tutorial/en.mdx:16
#, no-wrap
msgid ""
"You should have installed:\n"
"- Go 1.24+\n"
msgstr ""
"以下をインストールしておいてください。\n"
"- Go 1.24以上\n"

#. type: Plain text
#: src/guides/go-oauth-cli-tutorial/en.mdx:22
#, no-wrap
msgid ""
"```bash\n"
"brew install go\n"
"```\n"
msgstr ""
"```bash\n"
"brew install go\n"
"```\n"

#. type: Plain text
#: src/guides/go-oauth-cli-tutorial/en.mdx:24
#: src/guides/oauth-cli-tutorial/en.mdx:24
#, no-wrap
msgid "You should also have an atproto handle to test with.\n"
msgstr "テスト用atprotoハンドルも用意しておいてください。\n"

#. type: Plain text
#: src/guides/go-oauth-cli-tutorial/en.mdx:28
#, no-wrap
msgid "Create a new Go module and install the [Go SDK](https://github.com/bluesky-social/indigo):\n"
msgstr "新しいGoモジュールを作成し、[Go SDK](https://github.com/bluesky-social/indigo)をインストールします。\n"

#. type: Plain text
#: src/guides/go-oauth-cli-tutorial/en.mdx:35
#, no-wrap
msgid ""
"```bash\n"
"mkdir go-oauth-cli\n"
"cd go-oauth-cli\n"
"go mod init go-oauth-cli\n"
"go get github.com/bluesky-social/indigo/atproto/auth/oauth\n"
"```\n"
msgstr ""
"```bash\n"
"mkdir go-oauth-cli\n"
"cd go-oauth-cli\n"
"go mod init go-oauth-cli\n"
"go get github.com/bluesky-social/indigo/atproto/auth/oauth\n"
"```\n"

#. type: Plain text
#: src/guides/go-oauth-cli-tutorial/en.mdx:37
#, no-wrap
msgid "That's it — the Go SDK includes everything you need for OAuth, including an in-memory session store for development.\n"
msgstr "以上です。Go SDKにはOAuthに必要なものがすべて含まれており、開発用のインメモリセッションストアも利用できます。\n"

#. type: Plain text
#: src/guides/go-oauth-cli-tutorial/en.mdx:39
#: src/guides/oauth-cli-tutorial/en.mdx:48
#, no-wrap
msgid "## Part 2: Build the OAuth Client\n"
msgstr "<Heading level={2} id=\"part-2-build-the-oauth-client\">パート2：OAuthクライアントを作る</Heading>\n"

#. type: Plain text
#: src/guides/go-oauth-cli-tutorial/en.mdx:41
#, no-wrap
msgid "Create `main.go`. Start with the imports and the OAuth client setup:\n"
msgstr "`main.go`を作成します。まずはインポートとOAuthクライアントのセットアップから始めます。\n"

#. type: Plain text
#: src/guides/go-oauth-cli-tutorial/en.mdx:44
#, no-wrap
msgid ""
"```go\n"
"package main\n"
msgstr ""
"```go\n"
"package main\n"

#. type: Plain text
#: src/guides/go-oauth-cli-tutorial/en.mdx:57
#, no-wrap
msgid ""
"import (\n"
"\t\"context\"\n"
"\t\"errors\"\n"
"\t\"fmt\"\n"
"\t\"log\"\n"
"\t\"net\"\n"
"\t\"net/http\"\n"
"\t\"net/url\"\n"
"\t\"os\"\n"
"\t\"os/exec\"\n"
"\t\"runtime\"\n"
"\t\"strings\"\n"
msgstr ""
"import (\n"
"\t\"context\"\n"
"\t\"errors\"\n"
"\t\"fmt\"\n"
"\t\"log\"\n"
"\t\"net\"\n"
"\t\"net/http\"\n"
"\t\"net/url\"\n"
"\t\"os\"\n"
"\t\"os/exec\"\n"
"\t\"runtime\"\n"
"\t\"strings\"\n"

#. type: Plain text
#: src/guides/go-oauth-cli-tutorial/en.mdx:60
#, no-wrap
msgid ""
"\t\"github.com/bluesky-social/indigo/atproto/auth/oauth\"\n"
")\n"
msgstr ""
"\t\"github.com/bluesky-social/indigo/atproto/auth/oauth\"\n"
")\n"

#. type: Plain text
#: src/guides/go-oauth-cli-tutorial/en.mdx:67
#, no-wrap
msgid ""
"func main() {\n"
"\tif len(os.Args) < 2 {\n"
"\t\tfmt.Fprintln(os.Stderr, \"Usage: go run main.go <your-handle>\")\n"
"\t\tos.Exit(1)\n"
"\t}\n"
"\thandle := os.Args[1]\n"
msgstr ""
"func main() {\n"
"\tif len(os.Args) < 2 {\n"
"\t\tfmt.Fprintln(os.Stderr, \"Usage: go run main.go <your-handle>\")\n"
"\t\tos.Exit(1)\n"
"\t}\n"
"\thandle := os.Args[1]\n"

#. type: Plain text
#: src/guides/go-oauth-cli-tutorial/en.mdx:73
#, no-wrap
msgid ""
"\tif err := run(context.Background(), handle); err != nil {\n"
"\t\tlog.Fatal(err)\n"
"\t}\n"
"}\n"
"```\n"
msgstr ""
"\tif err := run(context.Background(), handle); err != nil {\n"
"\t\tlog.Fatal(err)\n"
"\t}\n"
"}\n"
"```\n"

#. type: Plain text
#: src/guides/go-oauth-cli-tutorial/en.mdx:75
#, no-wrap
msgid "Now add the `run` function. First, set up a callback server on a random port, then configure the OAuth client:\n"
msgstr "次に`run`関数を追加します。まずランダムなポートでコールバックサーバーを立て、その後OAuthクライアントを設定します。\n"

#. type: Plain text
#: src/guides/go-oauth-cli-tutorial/en.mdx:85
#, no-wrap
msgid ""
"```go\n"
"func run(ctx context.Context, handle string) error {\n"
"\t// Start the callback server on a random available port\n"
"\tcallbackCh := make(chan url.Values, 1)\n"
"\tport, server, err := listenForCallback(ctx, callbackCh)\n"
"\tif err != nil {\n"
"\t\treturn err\n"
"\t}\n"
"\tdefer server.Close()\n"
msgstr ""
"```go\n"
"func run(ctx context.Context, handle string) error {\n"
"\t// 利用可能なランダムポートでコールバックサーバーを起動\n"
"\tcallbackCh := make(chan url.Values, 1)\n"
"\tport, server, err := listenForCallback(ctx, callbackCh)\n"
"\tif err != nil {\n"
"\t\treturn err\n"
"\t}\n"
"\tdefer server.Close()\n"

#. type: Plain text
#: src/guides/go-oauth-cli-tutorial/en.mdx:87
#, no-wrap
msgid "\tcallbackURL := fmt.Sprintf(\"http://127.0.0.1:%d/callback\", port)\n"
msgstr "\tcallbackURL := fmt.Sprintf(\"http://127.0.0.1:%d/callback\", port)\n"

#. type: Plain text
#: src/guides/go-oauth-cli-tutorial/en.mdx:93
#, no-wrap
msgid ""
"\t// Create an OAuth client with localhost config and in-memory storage\n"
"\tconfig := oauth.NewLocalhostConfig(callbackURL, []string{\"atproto\"})\n"
"\tstore := oauth.NewMemStore()\n"
"\toauthClient := oauth.NewClientApp(&config, store)\n"
"```\n"
msgstr ""
"\t// localhost設定とインメモリストレージでOAuthクライアントを作成\n"
"\tconfig := oauth.NewLocalhostConfig(callbackURL, []string{\"atproto\"})\n"
"\tstore := oauth.NewMemStore()\n"
"\toauthClient := oauth.NewClientApp(&config, store)\n"
"```\n"

#. type: Plain text
#: src/guides/go-oauth-cli-tutorial/en.mdx:95
#, no-wrap
msgid "`NewLocalhostConfig` sets up a loopback client.\n"
msgstr "`NewLocalhostConfig`はループバッククライアントを設定します。\n"

#. type: Plain text
#: src/guides/go-oauth-cli-tutorial/en.mdx:99
#: src/guides/oauth-cli-tutorial/en.mdx:87
#, no-wrap
msgid ""
"<Note>\n"
"OAuth loopback works by using a special redirect URI (like `http://127.0.0.1:PORT/callback`) to send authorization codes directly back to an app, which listens on a local port, avoiding browser-based callbacks and enabling secure, direct communication for token exchange. Instead of a web redirect, the app opens a local listener, you can auth in a browser, and the server redirects back to the app's local URI, letting the app grab the code and exchange it for a token. It's particularly useful for development scenarios.\n"
"</Note>\n"
msgstr "OAuthループバックは、特別なリダイレクトURI（例：`http://127.0.0.1:PORT/callback`）を使って認可コードをアプリへ直接返す仕組みです。アプリはローカルポートで待ち受けるため、ブラウザベースのコールバックを避けつつ安全にトークン交換できます。ウェブへのリダイレクトの代わりに、アプリがローカルリスナーを開き、ブラウザで認証したあとサーバーがアプリのローカルURIに戻すことで、アプリがコードを受け取ってトークンに交換します。特に開発時に有用です。\n"

#. type: Plain text
#: src/guides/go-oauth-cli-tutorial/en.mdx:101
#, no-wrap
msgid "`NewMemStore` provides in-memory session storage for development.\n"
msgstr "`NewMemStore`は開発向けのインメモリセッションストレージを提供します。\n"

#. type: Plain text
#: src/guides/go-oauth-cli-tutorial/en.mdx:103
#: src/guides/oauth-cli-tutorial/en.mdx:91
#, no-wrap
msgid "## Part 3: Login Flow\n"
msgstr "<Heading level={2} id=\"part-3-login-flow\">パート3：ログインフロー</Heading>\n"

#. type: Plain text
#: src/guides/go-oauth-cli-tutorial/en.mdx:105
#, no-wrap
msgid "Continue the `run` function with the login flow. This resolves the handle, opens the browser, and waits for the callback:\n"
msgstr "引き続き`run`関数にログインフローを実装します。ここではハンドルを解決し、ブラウザを開き、コールバックを待ちます。\n"

#. type: Plain text
#: src/guides/go-oauth-cli-tutorial/en.mdx:113
#, no-wrap
msgid ""
"```go\n"
"\t// Start the OAuth flow\n"
"\tfmt.Printf(\"Logging in as %s...\\n\", handle)\n"
"\tauthURL, err := oauthClient.StartAuthFlow(ctx, handle)\n"
"\tif err != nil {\n"
"\t\treturn fmt.Errorf(\"starting auth flow: %w\", err)\n"
"\t}\n"
msgstr ""
"```go\n"
"\t// OAuthフローを開始\n"
"\tfmt.Printf(\"Logging in as %s...\\n\", handle)\n"
"\tauthURL, err := oauthClient.StartAuthFlow(ctx, handle)\n"
"\tif err != nil {\n"
"\t\treturn fmt.Errorf(\"starting auth flow: %w\", err)\n"
"\t}\n"

#. type: Plain text
#: src/guides/go-oauth-cli-tutorial/en.mdx:122
#, no-wrap
msgid ""
"\t// Open the browser to the authorization URL\n"
"\tfmt.Printf(\"Opening browser...\\n\")\n"
"\tif !strings.HasPrefix(authURL, \"https://\") {\n"
"\t\treturn fmt.Errorf(\"unexpected non-https auth URL\")\n"
"\t}\n"
"\tif err := openBrowser(authURL); err != nil {\n"
"\t\tfmt.Printf(\"Could not open browser automatically.\\nPlease visit: %s\\n\", authURL)\n"
"\t}\n"
msgstr ""
"\t// 認可URLをブラウザで開く\n"
"\tfmt.Printf(\"Opening browser...\\n\")\n"
"\tif !strings.HasPrefix(authURL, \"https://\") {\n"
"\t\treturn fmt.Errorf(\"unexpected non-https auth URL\")\n"
"\t}\n"
"\tif err := openBrowser(authURL); err != nil {\n"
"\t\tfmt.Printf(\"Could not open browser automatically.\\nPlease visit: %s\\n\", authURL)\n"
"\t}\n"

#. type: Plain text
#: src/guides/go-oauth-cli-tutorial/en.mdx:127
#, no-wrap
msgid ""
"\t// Wait for the OAuth callback\n"
"\tfmt.Println(\"Waiting for authorization...\")\n"
"\tparams := <-callbackCh\n"
"```\n"
msgstr ""
"\t// OAuthコールバックを待つ\n"
"\tfmt.Println(\"Waiting for authorization...\")\n"
"\tparams := <-callbackCh\n"
"```\n"

#. type: Plain text
#: src/guides/go-oauth-cli-tutorial/en.mdx:129
#: src/guides/oauth-cli-tutorial/en.mdx:125
#, no-wrap
msgid "The flow works like this:\n"
msgstr "フローは次のように進みます。\n"

#. type: Plain text
#: src/guides/go-oauth-cli-tutorial/en.mdx:133
#, no-wrap
msgid ""
"1. `StartAuthFlow` resolves the user's handle, discovers their PDS, sends a [Pushed Authorization Request (PAR)](/guides/permission-sets#requesting-permissions), and returns an authorization URL.\n"
"2. The user's browser opens to a consent screen.\n"
"3. After the user approves, their PDS redirects back to `http://127.0.0.1:<port>/callback` with an authorization code.\n"
msgstr ""
"1. `StartAuthFlow`がユーザーのハンドルを解決し、PDSを発見し、[Pushed Authorization Request (PAR)](/guides/permission-sets#requesting-permissions)を送信して認可URLを返します。\n"
"2. ユーザーのブラウザで同意画面が開きます。\n"
"3. ユーザーが承認すると、PDSが認可コード付きで `http://127.0.0.1:<port>/callback` にリダイレクトします。\n"

#. type: Plain text
#: src/guides/go-oauth-cli-tutorial/en.mdx:135
#: src/guides/oauth-cli-tutorial/en.mdx:132
#, no-wrap
msgid "## Part 4: Use the Session\n"
msgstr "<Heading level={2} id=\"part-4-use-the-session\">パート4：セッションを使う</Heading>\n"

#. type: Plain text
#: src/guides/go-oauth-cli-tutorial/en.mdx:137
#, no-wrap
msgid "Complete the `run` function by exchanging the callback for a session and making an authenticated API call:\n"
msgstr "コールバックをセッションに交換し、認証付きAPI呼び出しを行う処理を追加して`run`関数を完成させます。\n"

#. type: Plain text
#: src/guides/go-oauth-cli-tutorial/en.mdx:145
#, no-wrap
msgid ""
"```go\n"
"\t// Exchange the authorization code for a session\n"
"\tsessData, err := oauthClient.ProcessCallback(ctx, params)\n"
"\tif err != nil {\n"
"\t\treturn fmt.Errorf(\"processing callback: %w\", err)\n"
"\t}\n"
"\tfmt.Printf(\"Logged in! DID: %s\\n\", sessData.AccountDID)\n"
msgstr ""
"```go\n"
"\t// 認可コードをセッションに交換\n"
"\tsessData, err := oauthClient.ProcessCallback(ctx, params)\n"
"\tif err != nil {\n"
"\t\treturn fmt.Errorf(\"processing callback: %w\", err)\n"
"\t}\n"
"\tfmt.Printf(\"Logged in! DID: %s\\n\", sessData.AccountDID)\n"

#. type: Plain text
#: src/guides/go-oauth-cli-tutorial/en.mdx:151
#, no-wrap
msgid ""
"\t// Resume the session to get an API client\n"
"\tsession, err := oauthClient.ResumeSession(ctx, sessData.AccountDID, sessData.SessionID)\n"
"\tif err != nil {\n"
"\t\treturn fmt.Errorf(\"resuming session: %w\", err)\n"
"\t}\n"
msgstr ""
"\t// セッションを再開してAPIクライアントを取得\n"
"\tsession, err := oauthClient.ResumeSession(ctx, sessData.AccountDID, sessData.SessionID)\n"
"\tif err != nil {\n"
"\t\treturn fmt.Errorf(\"resuming session: %w\", err)\n"
"\t}\n"

#. type: Plain text
#: src/guides/go-oauth-cli-tutorial/en.mdx:161
#, no-wrap
msgid ""
"\t// Fetch the user's session info to prove it works\n"
"\tclient := session.APIClient()\n"
"\tvar resp struct {\n"
"\t\tDID    string `json:\"did\"`\n"
"\t\tHandle string `json:\"handle\"`\n"
"\t}\n"
"\tif err := client.Get(ctx, \"com.atproto.server.getSession\", nil, &resp); err != nil {\n"
"\t\treturn fmt.Errorf(\"fetching session: %w\", err)\n"
"\t}\n"
msgstr ""
"\t// 動作確認としてユーザーのセッション情報を取得\n"
"\tclient := session.APIClient()\n"
"\tvar resp struct {\n"
"\t\tDID    string `json:\"did\"`\n"
"\t\tHandle string `json:\"handle\"`\n"
"\t}\n"
"\tif err := client.Get(ctx, \"com.atproto.server.getSession\", nil, &resp); err != nil {\n"
"\t\treturn fmt.Errorf(\"fetching session: %w\", err)\n"
"\t}\n"

#. type: Plain text
#: src/guides/go-oauth-cli-tutorial/en.mdx:166
#, no-wrap
msgid ""
"\tfmt.Printf(\"\\nSession:\\n\")\n"
"\tfmt.Printf(\"  Handle: %s\\n\", resp.Handle)\n"
"\tfmt.Printf(\"  DID:    %s\\n\", resp.DID)\n"
"\tfmt.Printf(\"  Host:   %s\\n\", sessData.HostURL)\n"
msgstr ""
"\tfmt.Printf(\"\\nSession:\\n\")\n"
"\tfmt.Printf(\"  Handle: %s\\n\", resp.Handle)\n"
"\tfmt.Printf(\"  DID:    %s\\n\", resp.DID)\n"
"\tfmt.Printf(\"  Host:   %s\\n\", sessData.HostURL)\n"

#. type: Plain text
#: src/guides/go-oauth-cli-tutorial/en.mdx:170
#, no-wrap
msgid ""
"\treturn nil\n"
"}\n"
"```\n"
msgstr ""
"\treturn nil\n"
"}\n"
"```\n"

#. type: Plain text
#: src/guides/go-oauth-cli-tutorial/en.mdx:172
#, no-wrap
msgid "`ProcessCallback` exchanges the authorization code for tokens. `ResumeSession` wraps those tokens in a session that handles DPoP signing and token refresh automatically. `APIClient()` returns an HTTP client pre-configured with the user's credentials — you can use it to make any [XRPC](/specs/xrpc) call.\n"
msgstr "`ProcessCallback`は認可コードをトークンに交換します。`ResumeSession`はそのトークンを、DPoP署名とトークン更新を自動処理するセッションとしてラップします。`APIClient()`はユーザー資格情報で事前設定済みのHTTPクライアントを返し、任意の[XRPC](/specs/xrpc)呼び出しに利用できます。\n"

#. type: Plain text
#: src/guides/go-oauth-cli-tutorial/en.mdx:174
#, no-wrap
msgid "## Part 5: Helper Functions\n"
msgstr "<Heading level={2} id=\"part-5-helper-functions\">パート5：ヘルパー関数</Heading>\n"

#. type: Plain text
#: src/guides/go-oauth-cli-tutorial/en.mdx:176
#, no-wrap
msgid "Add the callback server and browser-opening helpers:\n"
msgstr "コールバックサーバーとブラウザ起動のヘルパー関数を追加します。\n"

#. type: Plain text
#: src/guides/go-oauth-cli-tutorial/en.mdx:183
#, no-wrap
msgid ""
"```go\n"
"func listenForCallback(ctx context.Context, res chan url.Values) (int, *http.Server, error) {\n"
"\tlistener, err := net.Listen(\"tcp\", \"127.0.0.1:0\")\n"
"\tif err != nil {\n"
"\t\treturn 0, nil, err\n"
"\t}\n"
msgstr ""
"```go\n"
"func listenForCallback(ctx context.Context, res chan url.Values) (int, *http.Server, error) {\n"
"\tlistener, err := net.Listen(\"tcp\", \"127.0.0.1:0\")\n"
"\tif err != nil {\n"
"\t\treturn 0, nil, err\n"
"\t}\n"

#. type: Plain text
#: src/guides/go-oauth-cli-tutorial/en.mdx:186
#, no-wrap
msgid ""
"\tmux := http.NewServeMux()\n"
"\tserver := &http.Server{Handler: mux}\n"
msgstr ""
"\tmux := http.NewServeMux()\n"
"\tserver := &http.Server{Handler: mux}\n"

#. type: Plain text
#: src/guides/go-oauth-cli-tutorial/en.mdx:194
#, no-wrap
msgid ""
"\tmux.HandleFunc(\"/callback\", func(w http.ResponseWriter, r *http.Request) {\n"
"\t\tres <- r.URL.Query()\n"
"\t\tw.Header().Set(\"Content-Type\", \"text/html\")\n"
"\t\tw.WriteHeader(200)\n"
"\t\tw.Write([]byte(\"<h1>Authorized! You can close this tab.</h1>\"))\n"
"\t\tgo server.Shutdown(ctx)\n"
"\t})\n"
msgstr ""
"\tmux.HandleFunc(\"/callback\", func(w http.ResponseWriter, r *http.Request) {\n"
"\t\tres <- r.URL.Query()\n"
"\t\tw.Header().Set(\"Content-Type\", \"text/html\")\n"
"\t\tw.WriteHeader(200)\n"
"\t\tw.Write([]byte(\"<h1>Authorized! You can close this tab.</h1>\"))\n"
"\t\tgo server.Shutdown(ctx)\n"
"\t})\n"

#. type: Plain text
#: src/guides/go-oauth-cli-tutorial/en.mdx:200
#, no-wrap
msgid ""
"\tgo func() {\n"
"\t\tif err := server.Serve(listener); !errors.Is(err, http.ErrServerClosed) {\n"
"\t\t\tlog.Fatal(err)\n"
"\t\t}\n"
"\t}()\n"
msgstr ""
"\tgo func() {\n"
"\t\tif err := server.Serve(listener); !errors.Is(err, http.ErrServerClosed) {\n"
"\t\t\tlog.Fatal(err)\n"
"\t\t}\n"
"\t}()\n"

#. type: Plain text
#: src/guides/go-oauth-cli-tutorial/en.mdx:203
#, no-wrap
msgid ""
"\treturn listener.Addr().(*net.TCPAddr).Port, server, nil\n"
"}\n"
msgstr ""
"\treturn listener.Addr().(*net.TCPAddr).Port, server, nil\n"
"}\n"

#. type: Plain text
#: src/guides/go-oauth-cli-tutorial/en.mdx:215
#, no-wrap
msgid ""
"func openBrowser(url string) error {\n"
"\tswitch runtime.GOOS {\n"
"\tcase \"darwin\":\n"
"\t\treturn exec.Command(\"open\", url).Run()\n"
"\tcase \"windows\":\n"
"\t\treturn exec.Command(\"cmd\", \"/c\", \"start\", url).Run()\n"
"\tdefault:\n"
"\t\treturn exec.Command(\"xdg-open\", url).Run()\n"
"\t}\n"
"}\n"
"```\n"
msgstr ""
"func openBrowser(url string) error {\n"
"\tswitch runtime.GOOS {\n"
"\tcase \"darwin\":\n"
"\t\treturn exec.Command(\"open\", url).Run()\n"
"\tcase \"windows\":\n"
"\t\treturn exec.Command(\"cmd\", \"/c\", \"start\", url).Run()\n"
"\tdefault:\n"
"\t\treturn exec.Command(\"xdg-open\", url).Run()\n"
"\t}\n"
"}\n"
"```\n"

#. type: Plain text
#: src/guides/go-oauth-cli-tutorial/en.mdx:217
#, no-wrap
msgid "The callback server listens on `127.0.0.1:0`, which tells the OS to assign any available port. When the callback arrives, it sends the query parameters through a channel back to the main flow and shuts itself down.\n"
msgstr "コールバックサーバーは`127.0.0.1:0`でリッスンします。これはOSに利用可能な任意ポートの割り当てを指示します。コールバックが届くと、クエリパラメーターをチャネル経由でメインフローへ渡し、自身をシャットダウンします。\n"

